<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151712"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version"
        android:textColor="#BFC7A5"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/presetCurrentValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="現在: ザビモノ"
        android:textColor="#F0F3B2"
        android:textSize="18sp"
        android:textStyle="bold" />

    <GridLayout
        android:id="@+id/presetGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/presetBtn1"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:text="1\nザビモノ"
            android:textSize="16sp" />

        <Button
            android:id="@+id/presetBtn2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:text="2\nザビカラー"
            android:textSize="16sp" />

        <Button
            android:id="@+id/presetBtn3"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:text="3\nゆらモノ"
            android:textSize="16sp" />

        <Button
            android:id="@+id/presetBtn4"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:text="4\nゆらカラー"
            android:textSize="16sp" />
    </GridLayout>

    <Button
        android:id="@+id/btnSetWallpaper"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="壁紙に設定"
        android:textSize="16sp" />
</LinearLayout>
